# Server
PORT=3000

# STUN servers
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478,stun:stun.nextcloud.com:443

# TURN server
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349

# TURN authentication secret
# Replace this value with a secure random secret in production.
TURN_SECRET=change-this-secret

# TURN credential lifetime (seconds)
TURN_TTL=3600

# DANGER DANGER DANGER
# NEVER SHARE YOUR TURN SECRET KEY WITH ANYONE!