const DHT = require("bittorrent-dht");
const { codeToKey } = require("./signaling");

class ShoriuDHT {
    constructor() {
        this.dht = new DHT();
        this.ready = false;
    }

    async start() {
        if (this.ready) {
            return;
        }

        await new Promise((resolve, reject) => {
            this.dht.listen(0, () => {
                this.ready = true;
                console.log("[DHT] Node started.");
                resolve();
            });

            this.dht.once("error", reject);
        });
    }

    async publish(code, payload) {
        await this.start();

        const key = codeToKey(code);

        const value = Buffer.from(
            JSON.stringify(payload),
            "utf8"
        );

        if (value.length >= 1000) {
            throw new Error("DHT signaling payload is too large.");
        }

        return new Promise((resolve, reject) => {
            this.dht.put(
                {
                    v: value
                },
                (error, hash) => {
                    if (error) {
                        reject(error);
                        return;
                    }

                    resolve(hash.toString("hex"));
                }
            );
        });
    }

    async find(code) {
        await this.start();

        const key = codeToKey(code);

        return new Promise((resolve, reject) => {
            this.dht.get(
                key,
                (error, result) => {
                    if (error) {
                        reject(error);
                        return;
                    }

                    if (!result || !result.v) {
                        resolve(null);
                        return;
                    }

                    try {
                        resolve(
                            JSON.parse(
                                result.v.toString("utf8")
                            )
                        );
                    } catch {
                        resolve(null);
                    }
                }
            );
        });
    }

    destroy() {
        if (this.dht) {
            this.dht.destroy();
        }
    }
}

module.exports = {
    ShoriuDHT
};